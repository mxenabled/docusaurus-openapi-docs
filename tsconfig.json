{
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,

    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "types": ["node", "react", "react-dom"]
  },
  "include": ["scripts", "packages/**/*"]
}
